# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=launches

# Demo seller (no auth in MVP) — insert this row via supabase/seed.sql
DEMO_SELLER_ID=00000000-0000-0000-0000-000000000001

# Claude
ANTHROPIC_API_KEY=
CLAUDE_VISION_MODEL=claude-sonnet-5-5
CLAUDE_WRITER_MODEL=claude-opus-5-5

# Worker
MOCK_MODE=false            # true = no Claude / no ffmpeg, emits demo kit in ~40s
FFMPEG_PATH=ffmpeg
CAPTION_FONT=/System/Library/Fonts/Supplemental/Arial Bold.ttf
WORK_DIR=.work
